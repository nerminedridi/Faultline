# Copy to .env and fill in. .env is git-ignored.
LLM_PROVIDER=gemini              # gemini | ollama
GEMINI_API_KEY=                  # free key from https://aistudio.google.com
GEMINI_MODEL=gemini-3.5-flash-lite
OLLAMA_MODEL=qwen3:4b
OLLAMA_URL=http://localhost:11434
OLLAMA_THINK=false               # true lets reasoning models think first (much slower on a CPU)
